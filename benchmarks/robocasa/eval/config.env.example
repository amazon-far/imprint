IMPRINT_CHECKPOINT=/path/to/stage2/checkpoint
DINOV3_MODEL_PATH=/path/to/local/dinov3-model
# Optional: only needed when the policy environment's Transformers build
# does not provide DINOv3.
# DINOV3_RUNTIME_OVERLAY=/path/to/python-package-overlay
IMPRINT_POLICY_CONFIG=imprint_robocasa_full_attention_memft
IMPRINT_HISTORY_CONFIG=cosmo-wan-bottleneck-modul-robocasa-combined600-dinov3-memft.yaml
ROBOCASA_ROOT=/path/to/patched-robocasa
ROBOCASA_REPLAY_ASSETS=/path/to/extracted/robocasa-v1
ROBOCASA_TASK_GROUP=retrieve_fruit
ROBOCASA_OUTPUT=outputs/robocasa/retrieve_fruit

# Optional expert overrides. Normal reproductions should leave these unset and
# use the complete ROBOCASA_REPLAY_ASSETS bundle.
# ROBOCASA_MEMORY_DATA_ROOT=/path/to/memory-demo-hdf5
# ROBOCASA_MEMORY_STORE=/path/to/memory-store
# ROBOCASA_RETRIEVE_LINEAGE_MANIFEST=/path/to/retrieve-lineage.json
# ROBOCASA_RETRIEVE_SOURCE_ROOT=/path/to/retrieve-hdf5-root
# ROBOCASA_WASH_SCENE_ROOT=/path/to/wash-recorded-scenes
# ROBOCASA_SWEETEN_RECOVERED_ROOT=/path/to/sweeten-recorded-scenes
# ROBOCASA_PAN_TRANSFER_DATASET=/path/to/pan-transfer/lerobot
# ROBOCASA_RINSE_CUTTING_BOARD_DATASET=/path/to/rinse-board/lerobot
# ROBOCASA_NEW5_SCENE_ROOT=/path/to/robocasa365-extra5-scenes
